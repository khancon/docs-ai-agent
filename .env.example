# Configure these only in server secrets. Never use NEXT_PUBLIC_ for credentials.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
GENERATION_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DAILY_GENERATIONS=60
LOCAL_EMBEDDINGS=false
# Local development alternative; requests remain on your machine.
OLLAMA_URL=
OLLAMA_MODEL=qwen3:4b
# Frontend build-time API origin; leave empty for browser evidence search / same-origin Worker.
NEXT_PUBLIC_API_URL=
# Only for GitHub Pages project deployments; leave empty for Sites/Vercel.
NEXT_PUBLIC_BASE_PATH=
